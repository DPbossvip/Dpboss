PORT=3002
NODE_ENV=development
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=dpbossadmin
ADMIN_PASSWORD=ReplaceWithYourOwnStrongPassword123!
# Optional: set to a persistent disk path on Render, e.g. /var/data
# DATA_DIR=/var/data
# SattaAPI credentials (set privately in Render Environment; never commit real keys)
MATKA_API_URL=https://matkaapi.sattaapi.com/wp-json/satta/v1/results
MATKA_API_KEY=put_your_rotated_api_key_here
MATKA_DOMAIN_KEY=put_your_rotated_domain_key_here
MATKA_API_DOMAIN=your-render-domain.onrender.com
