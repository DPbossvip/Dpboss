PORT=3002
NODE_ENV=development
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=dpbossadmin
ADMIN_PASSWORD=ReplaceWithYourOwnStrongPassword123!
# Optional: set to a persistent disk path on Render, e.g. /var/data
# DATA_DIR=/var/data
# SattaAPI credentials: configure privately in Render Environment; never commit real keys
SATTA_API_URL=https://matkaapi.sattaapi.com/wp-json/satta/v1/results
SATTA_API_KEY=put_your_rotated_api_key_here
SATTA_DOMAIN_KEY=put_your_rotated_domain_key_here
SATTA_API_DOMAIN=dpboss-54z9.onrender.com
# Automatic refresh interval in milliseconds (default 300000 = 5 minutes; minimum 60000)
SATTA_API_REFRESH_MS=300000
